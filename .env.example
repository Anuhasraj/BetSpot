# ==========================================
# BetSpot Production Environment Configuration
# ==========================================
# Copy this file to .env on your production server and fill in strong secrets.

NODE_ENV="production"
PORT="3000"

# Persistent storage directory for SQLite database, daily backups, and secrets
BETSPOT_DATA_DIR=".betspot-data"

# Fixed 64+ char random hex secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=""
ADMIN_SESSION_SECRET=""

# Admin Portal Access (keep empty in repo; set real values only in server .env)
ADMIN_EMAIL=""
ADMIN_USERNAME=""
ADMIN_PASSCODE=""

# Public Application URL
APP_URL="https://yourdomain.com"
